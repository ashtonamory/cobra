---
import type { BookingSection } from "../../../packages/contracts/src/website.ts";
import Paragraphs from "../components/Paragraphs.astro";

const { section: s } = Astro.props as { section: BookingSection };
---
<div class="booking">
  {s.heading && <h2>{s.heading}</h2>}
  <Paragraphs text={s.body} class="lead" />
  <a class="button" href={s.url} rel="noopener noreferrer">{s.button}</a>
</div>

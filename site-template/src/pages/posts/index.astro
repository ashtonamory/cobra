---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { data, postsByDate } from "../../data.ts";
---
<Base title={`News · ${data.site.name}`} path="/posts/">
  <section class="section"><div class="wrap narrow">
    <h1>News</h1>
    <PostList posts={postsByDate()} />
  </div></section>
</Base>

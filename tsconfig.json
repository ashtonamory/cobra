{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@cobra/contracts": [
        "packages/contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/agent/**/*.ts",
    "scripts/**/*.ts"
  ]
}

            {
              "id": "n_b0dyxx0004",
              "name": "Body",
              "kind": "text",
              "x": 72,
              "y": 860,
              "width": 936,
              "height": 200,
              "content": "From 1 December: Monday to Saturday, 8am to 6pm.\nSee you soon!",
              "sizing": "fixed",
              "fills": [
                {
                  "type": "solid",
                  "color": "{color.paper}"
                }
              ],
              "style": {
                "font_family": "{font.body}",
                "font_weight": 400,

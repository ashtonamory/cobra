[Unit]
Description=Cobra terminal gateway (tmux over WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Home, never the package: `current` resolves to one build's folder when the
# unit starts, and a tmux server this unit forks keeps that folder as its own
# working directory for life. The installer prunes old builds, and from then
# on tmux 3.7 starts every new pane there, whatever -c says, so `claude`
# refuses to run ("The current working directory was deleted").
WorkingDirectory=%h
ExecStart=@PREFIX@/current/bin/node @PREFIX@/current/apps/agent/src/gateway/index.ts
Environment=COBRA_TERM_PORT=@TERM_PORT@
# install.sh writes ports and the machine name here; the line above is the default.
EnvironmentFile=-@CONFIG@/agent.env
Restart=always
RestartSec=3

# It spawns interactive shells as this user, which is the point. It binds
# loopback only.
NoNewPrivileges=true

# The default KillMode (control-group) would kill every tmux session this
# gateway ever spawned on each restart, because tmux's server never leaves the
# unit's cgroup. `process` signals only the node process. This protects
# `restart` and NOT `stop`: a stop still ends every session when the cgroup is
# released. Restart freely; never `stop` it while sessions matter.
KillMode=process

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cobra-term

[Install]
WantedBy=default.target

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobra",
  "version": "0.4.0",
  "identifier": "app.cobra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cobra",
        "url": "index.html?surface=main",
        "width": 1240,
        "height": 820,
        "minWidth": 380,
        "minHeight": 320,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; child-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cobra for Linux and macOS",
    "longDescription": "The desktop app for Cobra: your business and life on this computer, what needs you, and the agent that runs it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBM0UyMjNBNThBRUY0NTMKUldSVDlLNVlPaUkrbWlYUHl1K3NuR2wyV0tHS1I3bzVFbEJlUXZRUG1odmtiNEhzL2Z5cEFKc20K",
      "endpoints": []
    }
  }
}

[Unit]
Description=Cobra desktop (cobra-desktop): needs-you popups, the bar count, SUPER+P picker
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cobra-desktop --hidden
Restart=on-failure
RestartSec=3
# Only the app itself stops on a restart. An older desk opened terminals,
# and a tmux server one of them started sits in this unit's cgroup on a
# computer that was updated; with the default (control-group) a reinstall
# would kill it, and with it every session on that tmux server.
KillMode=process

[Install]
WantedBy=graphical-session.target
